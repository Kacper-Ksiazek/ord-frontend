{
	"extends": "$app/tsconfig",
	"include": ["src", "vite.config.ts", "kit.config.js"],
	"exclude": ["src/service-worker"],
	"compilerOptions": {
		"allowJs": true,
		"allowArbitraryExtensions": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler"
	}
	// Path aliases ($lib and the FDD feature aliases) come from the `alias` option in kit.config.js.
}

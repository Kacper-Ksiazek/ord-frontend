# GitHub Packages token (required for bun install — see README)
GITHUB_TOKEN=

# Backend API URL (required — used by $env/static/public)
PUBLIC_API_URL=http://localhost:8080

# Optional dev helper: prefill login email in local development
PUBLIC_DEV_LOGIN_EMAIL=

# Optional dev helper: prefill OTP when PUBLIC_DEV_LOGIN_EMAIL is set (default: 123456)
PUBLIC_DEV_LOGIN_OTP=123456

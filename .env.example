# GitHub Packages token (required for bun install — see README)
GITHUB_TOKEN=

# Backend API URL (required — used by $env/static/public)
PUBLIC_API_URL=http://localhost:8080

# Sentry (optional — client error monitoring, no session replay)
# DSN from https://kksiazek.sentry.io → Project Settings → Client Keys
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_ENVIRONMENT=development
# Set to true when verifying the integration locally
PUBLIC_SENTRY_DEBUG=false

# Build-time only — uploads source maps during `bun run build` (Vercel: project env vars)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=kksiazek
# SENTRY_PROJECT=ord-ui

# Set automatically by Playwright E2E (make test-e2e / test:e2e:ui) — disables dev login prefilling
# PUBLIC_E2E=true

# Optional dev helper: prefill login email in local development (ignored when PUBLIC_E2E=true)
PUBLIC_DEV_LOGIN_EMAIL=

# Optional dev helper: prefill OTP when PUBLIC_DEV_LOGIN_EMAIL is set (default: 123456)
PUBLIC_DEV_LOGIN_OTP=123456
